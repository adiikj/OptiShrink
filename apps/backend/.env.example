NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optishrink

# Use long random strings, for example: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=30d

# Image compression (Cloudinary)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PDF compression (pdf.co)
PDFCO_API_KEY=
